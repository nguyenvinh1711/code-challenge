NODE_ENV=development
PORT=3000

# Storage backend: 'sqlite' (default, file-based) or 'postgres'.
DB_DRIVER=sqlite

# --- sqlite settings (used when DB_DRIVER=sqlite) ---
# Path is relative to repo root, or absolute, or ':memory:'.
# Default: problem5/data/items.sqlite
# DB_PATH=problem5/data/items.sqlite

# --- postgres settings (used when DB_DRIVER=postgres) ---
# DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<database> # Example: postgres://postgres:postgres@localhost:5432/postgres
# PG_POOL_MAX=10 # Default: 10
# Optional: separate read replica connection
# READ_DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<database> # Example: postgres://postgres:postgres@replica:5432/items
