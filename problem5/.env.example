NODE_ENV=development
PORT=3000

# Storage backend: 'sqlite' (default, file-based) or 'postgres'.
DB_DRIVER=sqlite

# --- sqlite settings (used when DB_DRIVER=sqlite) ---
# Path is relative to repo root, or absolute, or ':memory:'.
# Default: problem5/data/items.sqlite
# DB_PATH=problem5/data/items.sqlite

# --- postgres settings (used when DB_DRIVER=postgres) ---
# DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<database> # Example: postgres://postgres:postgres@localhost:5432/postgres
# PG_POOL_MAX=10 # Default: 10
# Optional: separate read replica connection
# READ_DATABASE_URL=postgres://<user>:<pass>@<host>:<port>/<database> # Example: postgres://postgres:postgres@replica:5432/items

# --- Cache layer ---
# CACHE_DRIVER=memory|redis|none (default: memory; 'none' under NODE_ENV=test)
# CACHE_DRIVER=memory
# REDIS_URL=redis://localhost:6379       # Required when CACHE_DRIVER=redis
# CACHE_TTL_ITEM_MS=60000                # Single-item cache TTL
# CACHE_TTL_LIST_MS=30000                # List response cache TTL
# CACHE_TTL_NEGATIVE_MS=5000             # 404 / negative-result cache TTL
# CACHE_MAX_ENTRIES=1000                 # Memory-cache LRU capacity
# CACHE_KEY_PREFIX=p5:                   # Key namespace

# --- docker-compose only (assembled into DATABASE_URL & REDIS_URL) ---
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=items
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# APP_PORT=3000
